# 熔岩网络安全事件应急处置系统 systemd 服务单元
# 安装：
#   sudo cp deploy/monitor.service /etc/systemd/system/
#   sudo cp deploy/monitor.yaml /etc/monitor/monitor.yaml   # 修改配置
#   sudo mkdir -p /opt/monitor/data && sudo cp bin/monitor-linux-amd64 /opt/monitor/monitor
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now monitor

[Unit]
Description=Lava Network Security Incident Emergency Response System
Documentation=file:///opt/monitor/README.md
After=network.target

[Service]
Type=simple
# 建议使用专用低权限账号；普通用户即可读取 /proc 与 systemd D-Bus。
# 注意：若需启用「进程管理（kill/重启）+ 服务管理（start/stop/restart/enable/disable）」，
# 进程管理要求与目标进程同权限（通常需 root），systemd StartUnit/EnableUnitFiles 也需要更高
# D-Bus 策略权限——届时请将 User/Group 改为 root（或为 monitor 配置 polkit/systemd 授权）。
# 默认低权限运行仅支持只读监控，管理操作会返回 403 权限不足。
User=monitor
Group=monitor
WorkingDirectory=/opt/monitor
ExecStart=/opt/monitor/monitor -c /etc/monitor/monitor.yaml
Restart=on-failure
RestartSec=5
Environment=GIN_MODE=release
# SQLite WAL 与网络连接需要较多文件描述符
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
# 采集 systemd 服务状态需访问 system bus，普通用户默认可用

[Install]
WantedBy=multi-user.target
