# 部署环境配置与敏感数据模板：复制为 .env 并填写（.env 已被 .gitignore 排除）
# 与本仓库绑定的非敏感配置（应用名/端口/编译入口等）已写死在 scripts/deploy.py 中

# --- SSH 连接信息（必填） ---
SSH_HOST=your-server-ip
SSH_USER=root
SSH_PORT=22
SSH_ARCH=amd64

# --- 敏感数据（必填） ---
# SSH 密码
DEPLOY_PASSWORD=change-me

# JWT 签名密钥（建议随机 32 位，如：openssl rand -hex 16 或 python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"）
JWT_SECRET=change-me
